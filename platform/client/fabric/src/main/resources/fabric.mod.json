{
  "schemaVersion": 1,
  "id": "dreamdisplays",
  "name": "Dream Displays",
  "version": "${version}",
  "license": "LGPL-3.0",
  "description": "Create in-game screens to stream your favorite videos in Minecraft.",
  "authors": [
    "arnodoelinger, INotSleep, Kolyakot33, Toffikk"
  ],
  "contact": {
    "homepage": "https://github.com/Carter4242/dreamdisplays-1.21.8-fabric",
    "sources": "https://github.com/Carter4242/dreamdisplays-1.21.8-fabric",
    "issues": "https://github.com/Carter4242/dreamdisplays-1.21.8-fabric/issues"
  },
  "entrypoints": {
    "client": [
      "com.dreamdisplays.platform.client.Client"
    ],
    "main": [
      "com.dreamdisplays.platform.server.Server"
    ],
    "modmenu": [
      "com.dreamdisplays.platform.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "dreamdisplays.mixins.json",
    "dreamdisplays.server.mixins.json"
  ],
  "accessWidener": "dreamdisplays.classtweaker",
  "depends": {
    "fabricloader": "${loaderDependency}",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  },
  "suggests": {
    "luckperms": "*",
    "cloth-config": "*",
    "modmenu": "*"
  },
  "icon": "assets/dreamdisplays/icon.png"
}
